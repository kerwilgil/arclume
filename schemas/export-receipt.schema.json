{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclume.dev/schema/export-receipt.json",
  "title": "Arclume export receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "format",
    "exporter",
    "deck",
    "diagramArtifacts",
    "output",
    "slideCount",
    "validation"
  ],
  "properties": {
    "receiptVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "format": { "enum": ["pdf", "pptx"] },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chromiumVersion": { "type": "string", "minLength": 1 }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irVersion", "contentHash"],
      "properties": {
        "irVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contentHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "canonicalHtmlSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "printProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "cssSha256"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "cssSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "layoutProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "aspectRatio"],
      "properties": {
        "version": { "type": "string" },
        "aspectRatio": { "enum": ["16:9", "16:10", "4:3"] }
      }
    },
    "diagramArtifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "diagramId",
          "engineRequested",
          "engineUsed",
          "specHash",
          "diagramRenderInputHash"
        ],
        "properties": {
          "diagramId": { "type": "string", "minLength": 1 },
          "engineRequested": { "type": "string" },
          "engineUsed": { "type": "string" },
          "specHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "diagramRenderInputHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "svgSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "fallbackCode": { "type": "string" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "bytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "slideCount": { "type": "integer", "minimum": 0 },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors", "warnings"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "const": "pdf" } } },
      "then": {
        "required": ["canonicalHtmlSha256", "printProfile", "runtime"],
        "properties": {
          "layoutProfile": false,
          "canonicalHtmlSha256": true,
          "printProfile": true,
          "runtime": {
            "type": "object",
            "required": ["chromiumVersion"],
            "properties": {
              "chromiumVersion": true
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "format": { "const": "pptx" } } },
      "then": {
        "required": ["layoutProfile"],
        "properties": {
          "layoutProfile": true,
          "canonicalHtmlSha256": false,
          "printProfile": false,
          "runtime": false
        }
      }
    }
  ]
}
