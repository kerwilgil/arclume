{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclume.dev/schema/visual-qa.json",
  "title": "Arclume Visual QA result",
  "description": "The serializable result of a Chromium Visual QA run (Phase 6). Browser-bound, deterministic within a fixed browser/platform/config. Screenshot buffers are never part of this document — only their descriptors and SHA-256 hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "valid",
    "browser",
    "input",
    "viewports",
    "findings",
    "screenshots",
    "summary"
  ],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "valid": { "type": "boolean" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["htmlSha256"],
      "description": "Cryptographic identity of the exact HTML opened in Chromium. Computed by runVisualQa from its own input; never caller-supplied.",
      "properties": {
        "htmlSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform", "deviceScaleFactor"],
      "properties": {
        "name": { "const": "chromium" },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewport",
          "width",
          "height",
          "deviceScaleFactor",
          "slideCount",
          "findings",
          "errors",
          "warnings",
          "info"
        ],
        "properties": {
          "viewport": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "exclusiveMinimum": 0 },
          "height": { "type": "integer", "exclusiveMinimum": 0 },
          "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 },
          "slideCount": { "type": "integer", "minimum": 0 },
          "findings": { "type": "integer", "minimum": 0 },
          "errors": { "type": "integer", "minimum": 0 },
          "warnings": { "type": "integer", "minimum": 0 },
          "info": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "viewport", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^visual/[a-z0-9-]+$" },
          "severity": { "enum": ["error", "warning", "info"] },
          "viewport": { "type": "string", "minLength": 1 },
          "slideId": { "type": "string" },
          "slideIndex": { "type": "integer", "minimum": 0 },
          "blockId": { "type": "string" },
          "diagramId": { "type": "string" },
          "message": { "type": "string", "minLength": 1 },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "viewport",
          "slideId",
          "index",
          "kind",
          "width",
          "height",
          "bytes",
          "sha256",
          "path"
        ],
        "properties": {
          "viewport": { "type": "string", "minLength": 1 },
          "slideId": { "type": "string" },
          "index": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["slide", "viewer"] },
          "width": { "type": "integer", "minimum": 0 },
          "height": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "path": { "type": "string", "pattern": "^screenshots/[A-Za-z0-9._-]+\\.png$" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "warnings", "info"],
      "properties": {
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
