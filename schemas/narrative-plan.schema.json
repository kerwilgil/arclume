{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclume.dev/schema/narrative-plan.json",
  "title": "Arclume NarrativePlan",
  "description": "Audience-shaped narrative for a ProjectKnowledge: what to tell, in what order, what to omit and why. Render-independent, theme-independent, deterministic. Consumed by the SlidePlanner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "narrativeVersion",
    "audience",
    "objective",
    "throughline",
    "sections",
    "selection",
    "decisions",
    "notes"
  ],
  "properties": {
    "narrativeVersion": { "$ref": "https://arclume.dev/schema/common.json#/$defs/semver" },
    "meta": { "$ref": "#/$defs/planMeta" },
    "audience": { "$ref": "#/$defs/audience" },
    "deckType": { "$ref": "#/$defs/deckType" },
    "knowledgeHash": { "$ref": "https://arclume.dev/schema/common.json#/$defs/contentHash" },
    "objective": { "$ref": "#/$defs/paragraph" },
    "throughline": { "$ref": "#/$defs/paragraph" },
    "sections": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/section" }
    },
    "selection": { "$ref": "#/$defs/selection" },
    "decisions": {
      "type": "array",
      "maxItems": 400,
      "items": { "$ref": "#/$defs/decision" }
    },
    "notes": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/note" }
    }
  },
  "$defs": {
    "id": { "$ref": "https://arclume.dev/schema/common.json#/$defs/id" },
    "idArray": { "$ref": "https://arclume.dev/schema/common.json#/$defs/idArray" },
    "shortText": { "$ref": "https://arclume.dev/schema/common.json#/$defs/shortText" },
    "paragraph": { "type": "string", "minLength": 1, "maxLength": 600 },
    "audience": {
      "type": "string",
      "enum": [
        "executive",
        "technical",
        "general",
        "product",
        "client",
        "investor",
        "internal-review"
      ]
    },
    "deckType": {
      "type": "string",
      "enum": [
        "project-overview",
        "architecture-review",
        "technical-deep-dive",
        "executive-brief",
        "proposal",
        "status-report",
        "migration-plan",
        "product-overview",
        "incident-postmortem"
      ]
    },
    "narrativePurpose": {
      "type": "string",
      "enum": [
        "context",
        "problem",
        "solution",
        "impact",
        "capability",
        "architecture",
        "process",
        "evidence",
        "risk",
        "roadmap",
        "status",
        "next-steps",
        "summary",
        "call-to-action"
      ]
    },
    "omissionReason": {
      "type": "string",
      "enum": [
        "irrelevant-to-audience",
        "redundant",
        "insufficient-evidence",
        "low-priority",
        "slide-budget",
        "superseded"
      ]
    },
    "planMeta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator": { "$ref": "#/$defs/shortText" },
        "contentHash": { "$ref": "https://arclume.dev/schema/common.json#/$defs/contentHash" }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "purpose", "narrativePurpose", "priority", "knowledgeRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/shortText" },
        "purpose": { "$ref": "#/$defs/paragraph" },
        "narrativePurpose": { "$ref": "#/$defs/narrativePurpose" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 999 },
        "knowledgeRefs": { "$ref": "#/$defs/idArray" },
        "transitionIntent": { "$ref": "#/$defs/shortText" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "deprioritized", "omitted"],
      "properties": {
        "selected": { "$ref": "#/$defs/idArray" },
        "deprioritized": { "$ref": "#/$defs/idArray" },
        "omitted": {
          "type": "array",
          "maxItems": 4000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "reason"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "reason": { "$ref": "#/$defs/omissionReason" },
              "note": { "$ref": "#/$defs/shortText" }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "decision", "reason"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 48 },
        "sectionId": { "$ref": "#/$defs/id" },
        "slideId": { "$ref": "#/$defs/id" },
        "decision": { "$ref": "#/$defs/shortText" },
        "reason": { "$ref": "#/$defs/paragraph" },
        "knowledgeRefs": { "$ref": "#/$defs/idArray" }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(planning|narrative|plan)/[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "message": { "$ref": "#/$defs/paragraph" },
        "severity": { "type": "string", "enum": ["info", "warning"] }
      }
    }
  }
}
