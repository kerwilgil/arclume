{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclume.dev/schema/common.json",
  "title": "Arclume Common Definitions",
  "description": "Shared definitions used by both the ProjectKnowledge model and the ArclumeDeck IR. These $id values are stable identifiers, not network locations; validators never fetch them.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable, human-authorable identifier. Must start with a letter; letters, digits, hyphen and underscore only."
    },
    "idArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" }
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$",
      "description": "SemVer 2.0.0 core version with optional pre-release."
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 date-time. Only present in artifacts when explicitly injected by a caller."
    },
    "dateHint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "Free-form date as found in the source ('2026-09-01', 'Q3 2026', 'next sprint'). Not parsed in Phase 1."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Lowercase hex SHA-256 of stable-stringified content, prefixed with 'sha256:'."
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "Git commit SHA (abbreviated or full)."
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "factType": {
      "type": "string",
      "enum": ["FACT", "INFERENCE", "UNKNOWN", "RECOMMENDATION"],
      "description": "Epistemic status. Content without sufficient evidence must never be silently promoted to FACT (enforced by semantic validation)."
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": { "$ref": "#/$defs/shortText" },
      "maxItems": 24
    },
    "locator": {
      "description": "Points into a source. Discriminated by 'kind'. Designed to grow; every variant may also carry 'commit' and 'note'.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "file" },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "description": "POSIX-style, source-root-relative path. No leading slash, no '..' segments (enforced by semantic validation)."
            },
            "lineStart": { "type": "integer", "minimum": 1 },
            "lineEnd": { "type": "integer", "minimum": 1 },
            "commit": { "$ref": "#/$defs/commitSha" },
            "note": { "$ref": "#/$defs/shortText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "page"],
          "properties": {
            "kind": { "const": "page" },
            "page": { "type": "integer", "minimum": 1 },
            "pageEnd": { "type": "integer", "minimum": 1 },
            "commit": { "$ref": "#/$defs/commitSha" },
            "note": { "$ref": "#/$defs/shortText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "url" },
            "url": { "type": "string", "format": "uri", "maxLength": 2048 },
            "commit": { "$ref": "#/$defs/commitSha" },
            "note": { "$ref": "#/$defs/shortText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "anchor"],
          "properties": {
            "kind": { "const": "fragment" },
            "anchor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "description": "Named section, heading path, or selector inside the source."
            },
            "commit": { "$ref": "#/$defs/commitSha" },
            "note": { "$ref": "#/$defs/shortText" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "charStart", "charEnd"],
          "properties": {
            "kind": { "const": "text-range" },
            "charStart": { "type": "integer", "minimum": 0 },
            "charEnd": { "type": "integer", "minimum": 0 },
            "commit": { "$ref": "#/$defs/commitSha" },
            "note": { "$ref": "#/$defs/shortText" }
          }
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "locator": { "$ref": "#/$defs/locator" },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Verbatim excerpt from the source supporting the reference."
        }
      }
    },
    "sourceRefArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRef" },
      "maxItems": 32
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": {
          "type": "string",
          "enum": [
            "repo",
            "directory",
            "markdown",
            "text",
            "json",
            "yaml",
            "pdf",
            "docx",
            "url",
            "other"
          ]
        },
        "title": { "$ref": "#/$defs/shortText" },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Path or URL exactly as supplied by the caller. Not resolved by the Core."
        },
        "hash": { "$ref": "#/$defs/contentHash" },
        "mediaType": { "$ref": "#/$defs/shortText" },
        "retrievedAt": { "$ref": "#/$defs/isoDateTime" },
        "note": { "$ref": "#/$defs/shortText" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "factType", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "factType": { "$ref": "#/$defs/factType" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefArray" },
        "supports": {
          "$ref": "#/$defs/idArray",
          "description": "Ids of entities or other claims this claim provides evidence for."
        },
        "note": { "$ref": "#/$defs/shortText" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRefs"],
      "description": "Deck-side vehicle that attaches source references (and optionally a classification or a link to a knowledge Claim) to a slide or block.",
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "factType": { "$ref": "#/$defs/factType" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "confidence": { "$ref": "#/$defs/confidence" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefArray" }
      }
    },
    "relationType": {
      "type": "string",
      "enum": [
        "DEPENDS_ON",
        "PART_OF",
        "PRODUCES",
        "CONSUMES",
        "MITIGATES",
        "OWNS",
        "PRECEDES",
        "MEASURES",
        "IMPLEMENTS",
        "THREATENS",
        "DECIDES",
        "USES_TECHNOLOGY",
        "RESPONSIBLE_FOR",
        "DERIVED_FROM",
        "RELATES_TO"
      ]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "type", "sourceRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/relationType" },
        "label": { "$ref": "#/$defs/shortText" },
        "sourceRefs": { "$ref": "#/$defs/sourceRefArray" }
      }
    }
  }
}
