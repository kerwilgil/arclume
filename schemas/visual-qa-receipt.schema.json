{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arclume.dev/schema/visual-qa-receipt.json",
  "title": "Arclume Visual QA receipt",
  "description": "Hashable evidence that a specific HTML deck was validated by a specific Chromium build under a specific config. The canonical identity excludes ambient fields (temp paths, timestamps, PID, username); browser + platform are evidence and are included.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptVersion",
    "deck",
    "renderer",
    "visualQa",
    "browser",
    "inputs",
    "result",
    "screenshots"
  ],
  "properties": {
    "receiptVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["irVersion"],
      "properties": {
        "irVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": { "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" } }
    },
    "visualQa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "configHash"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "configHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "platform"],
      "properties": {
        "name": { "const": "chromium" },
        "version": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["htmlSha256"],
      "properties": { "htmlSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "commit"],
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "errors", "warnings"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "sha256", "bytes"],
        "properties": {
          "slideId": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
